  "links": [
    {
      "title": "关联明细 / API",
      "url": "http://localhost:8080/docs",
      "type": "link"
    },
    {
      "title": "Flink 作业",
      "url": "http://localhost:18081",
      "type": "link"
    }
  ],
  "description": "所有数据为合成广告事件。实时指标 provisional；CTR 与 CVR 使用各自 cohort。实验组对比不包含显著性检验。",
  "templating": {
    "list": [
      {
        "name": "campaign",
        "label": "活动",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(adpulse_business_value, campaign)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "region",
        "label": "国家 / 地区",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(adpulse_business_value, region)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "app_version",
        "label": "应用版本",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(adpulse_business_value, app_version)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  }
}
