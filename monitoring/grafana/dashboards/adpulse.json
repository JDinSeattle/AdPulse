{
  "uid": "adpulse-overview",
  "title": "AdPulse · 广告行为与质量治理",
  "tags": [
    "AdPulse",
    "synthetic-data"
  ],
  "schemaVersion": 40,
  "version": 2,
  "refresh": "10s",
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "当前发布版本",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "adpulse_active_release_info",
          "legendFormat": "{{variant}}{{disposition}}{{role}}{{topic}}{{release}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "曝光发生量",
      "type": "stat",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(adpulse_business_value{campaign=~\"$campaign\",region=~\"$region\",app_version=~\"$app_version\",cohort=\"occurrence\",measure=\"impressions\"})",
          "legendFormat": "{{variant}}{{disposition}}{{role}}{{topic}}{{release}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
